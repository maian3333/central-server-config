# Kafdrop server block with Keycloak authentication
server {
    listen 443 ssl;
    server_name kafdrop.${DOMAIN};

    # SSL configuration
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # DNS resolver for OpenID Connect
    resolver 8.8.8.8 ipv6=off;

    location / {
        # OpenID Connect authentication
        access_by_lua_block {
            local opts = {
                redirect_uri = "https://kafdrop.${DOMAIN}/oauth2/callback",
                discovery = "https://keycloak.${DOMAIN}/realms/jhipster/.well-known/openid-configuration",
                client_id = "${OIDC_CLIENT_ID}",
                client_secret = "${OIDC_CLIENT_SECRET}",
                scope = "openid email profile",
                ssl_verify = "no"
            }
            local res, err = require("resty.openidc").authenticate(opts)
            if err then
            ngx.status = 403
            ngx.say(err)
            ngx.exit(ngx.HTTP_FORBIDDEN)
            end
        }

        # Proxy configuration
        proxy_pass http://kafka-ui:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
# Consul server block with Keycloak authentication
server {
    listen 443 ssl;
    server_name consul.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    resolver 127.0.0.11 ipv6=off;

    # =========================
    # A. Consul API (/v1/*)
    # =========================
    location ~* ^/v1/ {

        access_by_lua_block {
            local headers = ngx.req.get_headers()
            
            -- Check for token in multiple places
            local token = headers["X-Consul-Token"] 
                       or ngx.var.arg_token  -- Query parameter ?token=xxx
                       or headers["Authorization"]  -- Bearer token
            
            -- Extract Bearer token if present
            if token and string.match(token, "^Bearer ") then
                token = string.sub(token, 8)
            end

            if not token then
                ngx.status = ngx.HTTP_FORBIDDEN
                ngx.say("Missing Consul ACL token")
                return ngx.exit(ngx.HTTP_FORBIDDEN)
            end

            -- Block anonymous token
            if token == "00000000-0000-0000-0000-000000000002" then
                ngx.status = ngx.HTTP_FORBIDDEN
                ngx.say("Anonymous token not allowed")
                return ngx.exit(ngx.HTTP_FORBIDDEN)
            end
            
            -- Set token for Consul
            ngx.req.set_header("X-Consul-Token", token)
        }

        proxy_pass http://consul:8500;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Consul-Token $http_x_consul_token;
    }

    # =========================
    # B. Consul UI (/)
    # =========================
    location / {
        access_by_lua_block {
            local opts = {
                redirect_uri = "https://consul.${DOMAIN}/oauth2/callback",
                discovery = "https://keycloak.${DOMAIN}/realms/jhipster/.well-known/openid-configuration",
                client_id = "${OIDC_CLIENT_ID}",
                client_secret = "${OIDC_CLIENT_SECRET}",
                scope = "openid profile email",
                ssl_verify = "no"
            }

            local res, err = require("resty.openidc").authenticate(opts)

            if err then
                ngx.status = ngx.HTTP_FORBIDDEN
                ngx.say(err)
                return ngx.exit(ngx.HTTP_FORBIDDEN)
            end
        }

        proxy_pass http://consul:8500;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
    }
}


# Kafdrop server block with Keycloak authentication
server {
    listen 443 ssl;
    server_name kafdrop.${DOMAIN};

    # SSL configuration
    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # DNS resolver for OpenID Connect
    resolver 8.8.8.8 ipv6=off;

    location / {
        # OpenID Connect authentication
        access_by_lua_block {
            local opts = {
                redirect_uri = "https://kafdrop.${DOMAIN}/oauth2/callback",
                discovery = "https://keycloak.${DOMAIN}/realms/jhipster/.well-known/openid-configuration",
                client_id = "${OIDC_CLIENT_ID}",
                client_secret = "${OIDC_CLIENT_SECRET}",
                scope = "openid email profile",
                ssl_verify = "no"
            }
            local res, err = require("resty.openidc").authenticate(opts)
            if err then
            ngx.status = 403
            ngx.say(err)
            ngx.exit(ngx.HTTP_FORBIDDEN)
            end
        }

        # Proxy configuration
        proxy_pass http://kafka-ui:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
# Consul server block with Keycloak authentication
server {
    listen 443 ssl;
    server_name consul.${DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Docker DNS resolver
    resolver 127.0.0.11 ipv6=off;

    # ======================
    #  A. API /v1 -> dùng ACL
    # ======================
    location ~* ^/v1/ {
        access_by_lua_block {
            if ngx.var.uri == "/v1/status/leader"
            or ngx.var.uri == "/v1/agent/self" then
                return
            end

            local headers = ngx.req.get_headers()
            local header_token = headers["x-consul-token"]

            local args = ngx.req.get_uri_args()
            local query_token = args["token"]

            if (header_token == "${CONSUL_HTTP_TOKEN}") or (query_token == "${CONSUL_HTTP_TOKEN}") then
                if header_token then
                    ngx.req.clear_header("X-Consul-Token")
                end
                if query_token then
                    args["token"] = nil
                    ngx.req.set_uri_args(args)
                end
                return
            end

            ngx.status = ngx.HTTP_FORBIDDEN
            ngx.say("Forbidden - invalid Consul ACL token")
            return ngx.exit(ngx.HTTP_FORBIDDEN)
        }

        proxy_pass http://consul:8500;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ======================
    #  B. UI / (mọi thứ còn lại) -> dùng Keycloak
    # ======================
    location / {
        access_by_lua_block {
            local opts = {
                redirect_uri = "https://consul.${DOMAIN}/oauth2/callback",
                discovery = "https://keycloak.${DOMAIN}/realms/jhipster/.well-known/openid-configuration",
                client_id = "${OIDC_CLIENT_ID}",
                client_secret = "${OIDC_CLIENT_SECRET}",
                scope = "openid email profile",
                ssl_verify = "no"
            }

            local res, err = require("resty.openidc").authenticate(opts)

            if err then
                ngx.status = 403
                ngx.say(err)
                return ngx.exit(ngx.HTTP_FORBIDDEN)
            end
        }

        proxy_pass http://consul:8500;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Authorization $http_authorization;
    }
}


